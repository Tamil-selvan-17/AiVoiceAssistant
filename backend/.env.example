APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
ENABLE_API_DOCS=true

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ai_voice_assistant

GEMINI_API_KEY=
# Leave blank to use the app's built-in default (currently gemini-2.5-flash
# for chat/STT -- see app/services/ai/gemini_provider.py). Google retires
# Gemini model versions periodically; if you start seeing AI_PROVIDER_ERROR
# / 404s in the logs, check https://ai.google.dev/gemini-api/docs/deprecations
# and set an explicit model here.
GEMINI_MODEL=

NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=

CORS_ORIGINS=http://localhost:8000

LOG_LEVEL=INFO

MAX_CONVERSATION_MINUTES=30
MAX_DAILY_AI_REQUESTS=100
AI_REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=120
