APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
ENABLE_API_DOCS=true

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ai_voice_assistant

GEMINI_API_KEY=
# Leave blank to use the app's built-in default (currently
# gemini-flash-latest -- Google's own alias for their current recommended
# flash model, see app/services/ai/gemini_provider.py). A pinned version
# number here (e.g. gemini-2.5-flash) will eventually get retired/renamed
# by Google and start returning AI_PROVIDER_ERROR/404s -- if that happens,
# check GET /api/ai/models?provider=gemini on your own deployment (or
# https://ai.google.dev/gemini-api/docs/deprecations) for what's currently
# available, and set an explicit model here if you don't want to rely on
# the alias.
GEMINI_MODEL=

NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=

CORS_ORIGINS=http://localhost:8000

LOG_LEVEL=INFO

MAX_CONVERSATION_MINUTES=30
MAX_DAILY_AI_REQUESTS=100
AI_REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=120
